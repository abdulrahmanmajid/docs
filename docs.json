{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Kallabot Docs",
  "description": "Kallabot builds AI agents that answer and make phone calls and reply on WhatsApp, Messenger, Instagram and website chat. Guides for owners, and the Kallabot API for developers.",
  "colors": {
    "primary": "#111216",
    "light": "#eeece7",
    "dark": "#ff5a1f"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#fbfaf8",
      "dark": "#0a0b0e"
    }
  },
  "fonts": {
    "heading": {
      "family": "Host Grotesk",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://kallabot.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Your agent",
            "pages": [
              "guides/agents",
              "guides/knowledge",
              "guides/tools"
            ]
          },
          {
            "group": "Phone",
            "pages": [
              "guides/phone-numbers",
              "guides/bring-your-own-carrier",
              "guides/verification",
              "guides/caller-trust"
            ]
          },
          {
            "group": "Chat channels",
            "pages": [
              "guides/web-chat",
              "guides/whatsapp",
              "guides/messenger-instagram"
            ]
          },
          {
            "group": "Conversations",
            "pages": [
              "guides/inbox",
              "guides/calls",
              "guides/live-console",
              "guides/voicemail",
              "guides/scheduled-calls",
              "guides/analytics"
            ]
          },
          {
            "group": "Your workspace",
            "pages": [
              "guides/team",
              "guides/minutes",
              "guides/billing",
              "guides/security"
            ]
          },
          {
            "group": "Connect other software",
            "pages": [
              "guides/workflows",
              "guides/webhooks",
              "guides/api-keys"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "icon": "terminal",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "developers/introduction",
              "developers/quickstart",
              "developers/sdks"
            ]
          },
          {
            "group": "Essentials",
            "pages": [
              "developers/authentication",
              "developers/errors",
              "developers/idempotency",
              "developers/concurrency",
              "developers/pagination",
              "developers/rate-limits",
              "developers/request-ids"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "developers/agents",
              "developers/knowledge",
              "developers/calls",
              "developers/web-calls",
              "developers/inbox",
              "developers/web-chat"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "developers/webhooks",
              "developers/events"
            ]
          },
          {
            "group": "Policies",
            "pages": [
              "developers/versioning"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "braces",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "pages": [
          "changelog"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Open Kallabot",
          "href": "https://kallabot.com",
          "icon": "phone"
        },
        {
          "anchor": "Email support",
          "href": "mailto:contact@kallabot.com",
          "icon": "mail"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Open the app",
        "href": "https://kallabot.com"
      },
      {
        "label": "Support",
        "href": "mailto:contact@kallabot.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://kallabot.com/settings?section=api-keys"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  },
  "search": {
    "prompt": "Search Kallabot docs"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Kallabot Docs",
      "og:image": "https://docs.kallabot.com/images/og.png",
      "twitter:card": "summary_large_image"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-spec",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/errors/:slug",
      "destination": "/developers/errors#:slug"
    },
    {
      "source": "/introduction",
      "destination": "/"
    },
    {
      "source": "/features/:slug*",
      "destination": "/"
    },
    {
      "source": "/concepts",
      "destination": "/"
    },
    {
      "source": "/tips-and-tricks",
      "destination": "/guides/agents"
    },
    {
      "source": "/change-log",
      "destination": "/changelog"
    }
  ],
  "footer": {
    "links": [
      {
        "header": "Kallabot",
        "items": [
          {
            "label": "Open the app",
            "href": "https://kallabot.com"
          },
          {
            "label": "Workflows",
            "href": "https://workflows.kallabot.com"
          }
        ]
      },
      {
        "header": "Help",
        "items": [
          {
            "label": "contact@kallabot.com",
            "href": "mailto:contact@kallabot.com"
          },
          {
            "label": "Changelog",
            "href": "/changelog"
          }
        ]
      }
    ]
  }
}
